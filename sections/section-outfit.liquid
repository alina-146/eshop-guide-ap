{{ 'section-outfit.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-outfit.js' | asset_url }}" defer="defer"></script>

<section-outfit class="section__outfit" role="region" aria-labelledby="outfit-title">
  {% if section.settings.outfit_title %}
    <h3 id="outfit-title" class="outfit_title">
      {{ section.settings.outfit_title }}
    </h3>
  {% endif %}
  {% if section.settings.outfit_image %}
    <div class="outfit_image" role="img" aria-label="Outfit image">
      {{ section.settings.outfit_image | image_url: width: 500 | image_tag }}
    </div>
  {% endif %}

  {% if section.settings.outfit_description %}
    <div class="outfit_description" role="note">
      {{ section.settings.outfit_description }}
    </div>
  {% endif %}

  {% if section.settings.outfit_products %}
    <div class="outfit_products" role="group" aria-label="Outfit product selection">
      {% for product in section.settings.outfit_products %}
        <div class="outfit_product" data-selected-variant-id="" role="group" aria-labelledby="product-title-{{ forloop.index }}">
          <h3 id="product-title-{{ forloop.index }}">{{ product.title }}</h3>
      
          {% if product.variants.size == 1 %}
            {% assign variant = product.variants.first %}
            <input
              type="hidden"
              name="variant-{{ product.id }}"
              value="{{ variant.id }}"
              data-autoselect
            >
          {% else %}
            <div class="variant-option">
              <label for="variant-select-{{ product.id }}" class="visually-hidden">Variante wählen</label>
              <select id="variant-select-{{ product.id }}" name="variant-{{ product.id }}" class="variant-select">
                <option value="">Bitte Variante wählen</option>
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}">{{ variant.title }}</option>
                {% endfor %}
              </select>
            </div>
          {% endif %}
        </div>
      {% endfor %}
      
      <div class="outfit-warning" hidden>Bitte wähle zuerst eine Variante für alle Produkte.</div>
      <button class="outfit-submit" role="button" disabled>buy outfit</button>

    </div>
  {% endif %}
</section-outfit>

{% schema %}
{
  "name": "t:sections.outfit.name",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "outfit_title",
      "label": "t:sections.outfit.settings.outfit_title.label"
    },
    {
      "type": "richtext",
      "id": "outfit_description",
      "label": "t:sections.outfit.settings.outfit_description.label"
    },    
    {
      "type": "product_list",
      "id": "outfit_products",
      "label": "t:sections.outfit.settings.outfit_products.label"
    },  
    {
      "type": "image_picker",
      "id": "outfit_image",
      "label": "t:sections.outfit.settings.outfit_products.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.outfit.presets.name"
    }
  ]
}
{% endschema %}
